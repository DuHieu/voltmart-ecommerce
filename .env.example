# ==============================================================================
# VoltMart Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# Supabase Credentials (Required for full auth and DB persistence)
# Find these in your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application URL (Used for redirects and auth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Polar Payment Configuration (Optional - for checkout processing)
POLAR_ACCESS_TOKEN=your_polar_access_token_here
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here
POLAR_PRODUCT_ID=your_polar_product_id_here
POLAR_ORG_ID=your_polar_organization_id_here